# Скопируйте файл в .env. Файл .env в репозиторий не попадает.

# Адрес модельного сервера с OpenAI-совместимым API.
# Ollama запущена на вашем компьютере (вариант для macOS и Windows):
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama запущена в контейнере командой make up-llm:
# LLM_BASE_URL=http://llm:11434/v1

LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=bge-m3
LLM_API_KEY=ollama

# Доля запросов, на которые ERP отвечает ошибкой 503. Для проверки повторов поставьте 0.3.
ERP_FAIL_RATE=0
